# Xcode build output and per-user state stay out of the repository.
build/
DerivedData/
xcuserdata/
*.xcuserstate
.DS_Store

# Secrets never live in this repository. Any key the app truly needs is
# provided through Xcode Cloud environment secrets or a local ignored
# config file, and only the secret's name is recorded in project docs.
*.local.xcconfig
Secrets*.plist
